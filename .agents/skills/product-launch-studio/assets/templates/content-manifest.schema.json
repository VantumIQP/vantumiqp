{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product Launch Content Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_id",
    "format",
    "locale",
    "approval_state",
    "dimensions",
    "elements"
  ],
  "properties": {
    "schema_version": { "type": "integer" },
    "manifest_id": { "type": "string" },
    "format": { "type": "string" },
    "locale": { "type": "string" },
    "approval_state": { "type": "string" },
    "owner_approved": { "type": "boolean" },
    "dimensions": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["element_id", "type", "order"],
        "properties": {
          "element_id": { "type": "string" },
          "type": { "type": "string" },
          "order": { "type": "integer" },
          "text": { "type": "string" },
          "claim_ids": { "type": "array", "items": { "type": "string" } },
          "asset_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "output_variants": { "type": "array" }
  }
}
