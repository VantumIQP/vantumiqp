{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Editable Carousel Manifest",
  "type": "object",
  "required": ["schema_version", "manifest_id", "slides"],
  "properties": {
    "schema_version": { "type": "integer" },
    "manifest_id": { "type": "string" },
    "campaign_id": { "type": "string" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide_id", "editable_svg", "pptx"],
        "properties": {
          "slide_id": { "type": "string" },
          "claim_ids": { "type": "array", "items": { "type": "string" } },
          "editable_svg": { "type": "string" },
          "pptx": { "type": "string" },
          "png_preview": { "type": "string" },
          "pdf_derivative": { "type": "string" },
          "source_screenshot": { "type": "string" },
          "alt_text": { "type": "string" }
        }
      }
    },
    "externally_import_tested": { "type": "boolean" },
    "external_import_evidence": { "type": "string" }
  }
}
